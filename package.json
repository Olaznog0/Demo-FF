{
  "name": "ocimatik-business-demo",
  "version": "2.0.0",
  "private": true,
  "description": "Configurable local-business demos with explicit integration states",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "node scripts/build-public.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check script.js && node --check appointment.js && node --check server.js",
    "build:pitch": "node scripts/build-pitch.js",
    "seo:refresh": "node scripts/update-showcase-seo.js"
  },
  "dependencies": {
    "@netlify/functions": "^5.2.1",
    "esbuild": "^0.25.0",
    "googleapis": "^171.4.0",
    "resend": "^6.12.3"
  },
  "engines": {
    "node": ">=22"
  }
}
