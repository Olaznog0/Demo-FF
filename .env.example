# FF credentials keep their original names. Other businesses use suffix __AYDEN, __FOGON, __DENTAL, __ACCOUNTING or __MOVING.
# Example names: RESEND_API_KEY__DENTAL, CONTACT_FROM_EMAIL__DENTAL, CONTACT_TO_EMAIL__DENTAL,
# GOOGLE_CALENDAR_ID__DENTAL, GOOGLE_CLIENT_EMAIL__DENTAL, GOOGLE_PRIVATE_KEY__DENTAL,
# BOOKING_FROM_EMAIL__DENTAL, BOOKING_ADMIN_EMAIL__DENTAL, BOOKING_BASE_URL__DENTAL.
# Keep private values in server environment only. Never copy calendar IDs between businesses.
# Calendar remains demo until that client's calendar.confirmed=true AND calendar.mode=api.
# New real-business configs can resolve Google Place ID using the server key, then verify phone and coordinates.
ACTIVE_CALENDAR_CLIENT_ID=
